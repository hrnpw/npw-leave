# Git and version control
.git
.gitignore

# Environment variables (will be set in Vercel dashboard)
.env
.env.local
.env*.local
*.env

# Dependencies (Vercel will install these)
node_modules

# Development files
coverage
*.log
.DS_Store

# IDE files
.vscode
.idea
*.swp
*.swo

# Backup folders
lib - backup*
*backup*

# Database files (use remote DB)
prisma/dev.db
prisma/*.db
prisma/*.db-journal

# Sensitive docs
VERCEL_ENV_SETUP.md

# Documentation (optional - keep if you want)
Docs/

# Test files (optional)
*.test.ts
*.test.tsx
__tests__/
vitest.config.ts
vitest.setup.ts
