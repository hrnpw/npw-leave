# Environment Variables

# Database
DATABASE_URL="postgresql://user:password@host:5432/database?pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://user:password@host:5432/database"

# Session Secret (generate with: openssl rand -base64 32)
SESSION_SECRET="your-secret-key-here"

# Bootstrap Admin (for first-time setup)
BOOTSTRAP_ADMIN_PASSWORD="change-me-on-first-login"

# Vercel Blob (optional - for file attachments)
BLOB_READ_WRITE_TOKEN=""

# Telegram (optional - for notifications)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Cron Secret (for Vercel Cron Jobs)
CRON_SECRET="your-cron-secret-here"

# Node Environment
NODE_ENV="development"
