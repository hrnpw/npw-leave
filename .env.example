# Environment Variables
# Neon Connection Pooler (for application queries)
DATABASE_URL="postgresql://neondb_owner:xxxxxxxxxxxxxxxxxxxxxxxxxxxxx.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=10&pool_timeout=30"
# Direct connection (for migrations only)
DIRECT_URL="postgresql://neondb_owner:xxxxxxxxxxxxxxxxxxxxxxxxxxxxx.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Session Secret (generate with: openssl rand -base64 32)
SESSION_SECRET="............................"

# Bootstrap Admin (for first-time setup)
BOOTSTRAP_ADMIN_PASSWORD="............................"

# Cloudflare R2 (for file attachments - signature images)
R2_ENDPOINT="............................"
R2_ACCESS_KEY_ID="............................"
R2_SECRET_ACCESS_KEY="............................"
R2_BUCKET_NAME="............................"
# R2_PUBLIC_URL="https://npw-leave.vercel.app/" # Optional: custom domain

# Telegram (optional - for notifications)
TELEGRAM_BOT_TOKEN="............................"
TELEGRAM_CHAT_ID="............................"

# Cron Secret (for Vercel Cron Jobs)
CRON_SECRET="............................"

# Node Environment
NODE_ENV="production"

# App URL (for PDF QR code and Telegram)
NEXT_PUBLIC_APP_URL="https://npw-leave.vercel.app/"
NEXT_PUBLIC_BASE_URL="https://npw-leave.vercel.app/"